<Project Sdk="MSTest.Sdk/4.2.3">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gearbox\Gearbox.csproj" />
    <ProjectReference Include="..\Gearbox.TestProcess\Gearbox.TestProcess.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.12.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>

  <Target Name="CopyTestProcess" AfterTargets="Build">
    <MSBuild Projects="..\Gearbox.TestProcess\Gearbox.TestProcess.csproj"
             Targets="GetTestProcessFiles" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="TestProcessFile" />
    </MSBuild>
    <Copy SourceFiles="@(TestProcessFile)"
          DestinationFiles="@(TestProcessFile->'$(TargetDir)test-process\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
